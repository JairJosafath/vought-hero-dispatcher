      "updated": 1789752435486,
      "link": null,
      "locked": false,
      "text": "Audit metadata stays outside Zone 3. Confidential bodies stay at the source; Government records scoped references and receipts.",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Audit metadata stays outside Zone 3. Confidential bodies stay at the source; Government records scoped references and receipts.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
